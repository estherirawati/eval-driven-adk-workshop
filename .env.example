# Option A (Recommended for Google Cloud Workshop): Vertex AI + Keyless ADC
# Run `gcloud auth application-default login` first — NO static JSON keys needed!
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B (Zero-Billing Local Fallback): Gemini Developer API (Google AI Studio)
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your_gemini_api_key_here
